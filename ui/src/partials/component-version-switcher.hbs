{{#if page.component.versions.[1]}}
  {{#with (component-versions-to-nav page.component) }}
    {{!-- On desktop the switcher sits on the same row as the first nav item,
          right-aligned, and stays at the top of the nav panel while the nav
          scrolls under it. The wrapper has no height so the nav does not move
          down. The border is a halo in the page background colour that hides
          nav text running under the button; its negative margins keep the
          button itself on the first row. --}}
    <div data-version-switcher class="lg:sticky lg:top-0 lg:z-10 lg:h-0 lg:flex lg:items-start lg:justify-end">
    <div data-dropdown data-dropdown-follow-link class="relative flex font-normal w-1/2 mt-6 mb-8 mr-2 lg:w-auto lg:m-0 lg:-mt-1 lg:-mr-[5px] lg:border-[5px] lg:border-body-bg lg:rounded-[6px] lg:bg-body-bg">
      <!-- Trigger Button -->
      <button
        data-dropdown-button
        class="px-2 py-1 border rounded-[6px] border-vapor bg-body-bg text-terminal-black leading-normal text-left flex items-center justify-between gap-[10px] focus:border-link-on-light hover:border-link-on-light"
        aria-haspopup="true"
        aria-expanded="false"
      >
        <span data-dropdown-selected>{{#if ./selected}}{{./selected}}{{else}}{{@root.page.component.title}}{{/if}}</span>
        {{> icon-arrow-right iconClass="w-3 h-3 rotate-90"}}
      </button>

      <!-- Dropdown Menu -->
      {{> dropdown-menu navList=./navList footerUrl=./aboutUrl footerLabel="About versions" }}
    </div>
    </div>
  {{/with}}
{{/if}}
