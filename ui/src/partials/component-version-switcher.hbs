{{#if page.component.versions.[1]}}
  {{#with (component-versions-to-nav page.component) }}
    {{!-- On desktop the switcher sits on the same row as the first nav item,
          right-aligned. left-side-nav makes the nav the positioning context. --}}
    <div data-dropdown class="relative flex font-normal w-1/2 mt-6 mb-8 mr-2 lg:absolute lg:top-px lg:right-0 lg:z-10 lg:w-auto lg:m-0">
      <!-- Trigger Button -->
      <button
        data-dropdown-button
        class="px-2 py-1 border rounded-[6px] border-vapor bg-body-bg text-terminal-black leading-normal text-left flex items-center justify-between gap-[10px] focus:border-link-on-light hover:border-link-on-light"
        aria-haspopup="true"
        aria-expanded="false"
      >
        <span data-dropdown-selected>{{#if ./selected}}{{./selected}}{{else}}{{@root.page.component.title}}{{/if}}</span>
        {{> icon-arrow-right iconClass="w-3 h-3 rotate-90"}}
      </button>

      <!-- Dropdown Menu -->
      {{> dropdown-menu navList=./navList }}
    </div>
  {{/with}}
{{/if}}
